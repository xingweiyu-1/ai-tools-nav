---
import { categoryMeta, formatNumber, starsOf, type Tool } from '../lib/tools'

interface Props {
  tool: Tool
}

const { tool } = Astro.props
const meta = categoryMeta(tool.data.category)
const stars = starsOf(tool)

const PRICE_STYLE: Record<string, string> = {
  免费: 'text-emerald-300 bg-emerald-500/10 ring-emerald-500/20',
  免费增值: 'text-sky-300 bg-sky-500/10 ring-sky-500/20',
  付费: 'text-amber-300 bg-amber-500/10 ring-amber-500/20',
  开源: 'text-violet-300 bg-violet-500/10 ring-violet-500/20',
}
---

<article
  data-category={tool.data.category}
  class={`group relative flex flex-col overflow-hidden rounded-2xl border border-white/5 bg-slate-900/60 p-5 backdrop-blur transition duration-200 hover:border-white/10 hover:bg-slate-900 hover:ring-1 ${meta.ring}`}
>
  <!-- 卡片悬停时的顶部光条 -->
  <div
    aria-hidden="true"
    class={`pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent opacity-0 transition group-hover:opacity-100`}
  ></div>

  <a href={`/tools/${tool.id}/`} class="flex h-full flex-col">
    <div class="flex items-start gap-3">
      <div
        class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-xl ${meta.iconBg}`}
      >
        {tool.data.icon}
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="truncate font-semibold text-slate-100 transition group-hover:text-white">
          {tool.data.name}
        </h3>
        <span
          class={`mt-1 inline-block rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset ${
            PRICE_STYLE[tool.data.price] ?? 'text-slate-300 bg-white/5 ring-white/10'
          }`}
        >
          {tool.data.price}
        </span>
      </div>
    </div>

    <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-400">
      {tool.data.description}
    </p>

    <div class="mt-3 flex flex-wrap gap-1.5">
      {tool.data.tags.slice(0, 3).map((tag) => (
        <span class="rounded-md bg-white/5 px-2 py-0.5 text-[11px] text-slate-400">
          {tag}
        </span>
      ))}
    </div>

    <div class="mt-auto flex items-center justify-between pt-4 text-xs text-slate-500">
      <span class="flex items-center gap-1.5">
        {stars != null && (
          <>
            <span class="text-amber-400">★</span>
            <span class="font-medium text-slate-400">{formatNumber(stars)}</span>
            <span class="text-slate-600">GitHub</span>
          </>
        )}
      </span>
      <span class="font-medium text-slate-400 transition group-hover:text-sky-300">
        详情 →
      </span>
    </div>
  </a>
</article>
