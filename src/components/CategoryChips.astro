---
import { categoryMeta, getCategories } from '../lib/tools'

const categories = await getCategories()
const total = categories.reduce((sum, c) => sum + c.count, 0)
---

<div id="category-chips" class="mt-6 flex flex-wrap items-center gap-2" role="group" aria-label="按分类筛选">
  <button
    data-filter="all"
    aria-pressed="true"
    class="inline-flex items-center gap-1.5 rounded-full border border-violet-500/40 bg-violet-500/15 px-3.5 py-1.5 text-sm font-medium text-violet-200 transition"
  >
    全部
    <span class="text-xs text-violet-300/70">({total})</span>
  </button>

  {
    categories.map((c) => {
      const meta = categoryMeta(c.label)
      return (
        <button
          data-filter={c.label}
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-slate-400 transition hover:border-white/20 hover:text-slate-200"
        >
          <span class={`h-1.5 w-1.5 rounded-full ${meta.dot}`}></span>
          {c.label}
          <span class="text-xs text-slate-500">({c.count})</span>
        </button>
      )
    })
  }
</div>
